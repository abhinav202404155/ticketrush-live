# Copy this file to ".env" (never commit .env). Demo values only.
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=change_me_demo
POSTGRES_DB=ticketrush
RABBITMQ_DEFAULT_USER=ticketrush
RABBITMQ_DEFAULT_PASS=change_me_demo
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_KEY=admin-demo-key
# Local dev limits are high so tests can run. Use low values in production.
AUTH_RATE_LIMIT=1000/minute
BOOKING_RATE_LIMIT=1000/minute
HOLD_SECONDS=300
# Artificial delay per booking in the worker, so scaling is visible under load.
WORK_DELAY_MS=0
