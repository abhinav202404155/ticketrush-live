{
  "rewrites": [
    { "source": "/api/users/:path*",    "destination": "https://ticketrush-user.onrender.com/api/users/:path*" },
    { "source": "/api/shows/:path*",    "destination": "https://ticketrush-catalog.onrender.com/api/shows/:path*" },
    { "source": "/api/events/:path*",   "destination": "https://ticketrush-catalog.onrender.com/api/events/:path*" },
    { "source": "/api/events",          "destination": "https://ticketrush-catalog.onrender.com/api/events" },
    { "source": "/api/cities",          "destination": "https://ticketrush-catalog.onrender.com/api/cities" },
    { "source": "/api/bookings/:path*", "destination": "https://ticketrush-booking.onrender.com/api/bookings/:path*" },
    { "source": "/api/bookings",        "destination": "https://ticketrush-booking.onrender.com/api/bookings" },
    { "source": "/api/admin/:path*",    "destination": "https://ticketrush-booking.onrender.com/api/admin/:path*" }
  ]
}
